{
  "name": "agentsd",
  "version": "0.1.0",
  "description": "Stream Deck plugin for Claude Code sessions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paultyng/agentsd.git"
  },
  "license": "MIT",
  "author": "Paul Tyng",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "streamdeck dev",
    "link": "streamdeck link com.paultyng.agentsd.sdPlugin",
    "unlink": "streamdeck unlink com.paultyng.agentsd",
    "hooks:install": "node -e \"import('./scripts/hooks.mjs').then(m => m.install())\"",
    "hooks:uninstall": "node -e \"import('./scripts/hooks.mjs').then(m => m.uninstall())\"",
    "debug:hooks": "node scripts/debug-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "brace-expansion": "^5.0.12"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "rollup": "^4.66.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
